{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-v-in-tag": false,
  "include-commit-authors": true,
  "changelog-sections": [
    {
      "type": "fix",
      "scope": "device",
      "section": "Devices"
    },
    {
      "type": "fix",
      "section": "Bug Fixes"
    },
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "chore",
      "section": "Miscellaneous Chores",
      "hidden": true
    }
  ],
  "packages": {
    ".": {
      "release-type": "simple",
      "extra-files": [
        {
          "type": "json",
          "path": "custom_components/tuya_ble/manifest.json",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
